# Point clangd at the CMake compile database.
#
# Without this clangd cannot find its compile_commands.json, falls back to guessed
# flags, and every #include "libslic3r/..." / "imgui/imgui.h" fails - which cascades
# into hundreds of bogus "unknown type name 'wxColour'" style errors that look like
# real code problems but are not. The database itself is generated by cmake at
# CONFIGURE time, so this works without a completed build.
#
# The debug tree is the one being built. Its compile_commands.json is regenerated
# when that directory is configured, and it includes the current sources.
#
# -fext-numeric-literals is a GCC-only flag that cmake bakes into the database for
# boost's __float128 handling. clangd drives real clang, which rejects it outright,
# so every TU opened here reported a bogus "Unknown argument" error at line 1 that
# crowded out genuine diagnostics. Strip it for clangd only - the GCC build still
# gets the flag from compile_commands.json.
CompileFlags:
  CompilationDatabase: build-linux-x86_64-debug
  Remove: [-fext-numeric-literals]

# Do not background-index this tree. clangd 23 parsed the project on all cores
# and held about 50 GB resident; each translation unit pulls in the precompiled
# header, so the index never stays small. Files are indexed when they are opened.
Index:
  Background: Skip
