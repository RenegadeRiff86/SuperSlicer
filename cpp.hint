// Visual Studio IntelliSense hint file.
//
// Purpose:
// - Provide a minimal set of preprocessor symbols so IntelliSense can follow
//   the common code paths in src/slic3r/GUI/GUI_App.cpp.
// - This helps reduce repeated VCR102 diagnostics caused by unresolved
//   platform / feature-gated branches while browsing.
//
// Usage for contributors:
// - Keep this file small and focused on frequently-hit gates.
// - After changing this file, reopen the solution (or refresh IntelliSense)
//   so the database is rebuilt with updated symbols.

// Primary platform gates used across GUI_App.cpp.
// Keep these aligned with the active Windows / Visual Studio environment.
#define _WIN32
#define WIN32
#define __WXMSW__

// SuperSlicer feature gates frequently encountered in GUI_App.cpp
#define _MSW_DARK_MODE
#define USE_GTHUB_PRESET_UPDATE
#define ENABLE_GL_CORE_PROFILE
#define ENABLE_THUMBNAIL_GENERATOR_DEBUG
#define GUI_TAG_PALETTE

// IntelliSense-only stubs for macros / forward declarations that frequently
// confuse the parser and pollute the Error List without affecting real builds.
class wxZipStreamLink;
#define wxDEFINE_EVENT(name, type)

// wxWidgets application entry point.
// Real expansion generates extern "C" WinMain() + global factory objects inside
// namespace scope, which breaks IntelliSense's structural analysis of the TU
// and produces dozens of "Browsing operations around this macro may fail" warnings.
#define wxIMPLEMENT_WXWIN_MAIN
#define wxIMPLEMENT_APP_NO_MAIN(appname)
#define wxIMPLEMENT_WX_THEME_SUPPORT
#define wxIMPLEMENT_APP_NO_THEMES(appname)
#define wxIMPLEMENT_APP(appname)
#define IMPLEMENT_APP(appname)

// wxWidgets assertion / guard macros.
// The else-branch contains a bare `return rc` or arbitrary `op` statement;
// IntelliSense loses track of the enclosing function return type when parsing.
#define wxCHECK2_MSG(cond, op, msg)
#define wxCHECK_MSG(cond, rc, msg)
#define wxCHECK_RET(cond, msg)
#define wxCHECK(cond, rc)

// Localisation helpers.
#define _L(x) x
#define _u8L(x) x
