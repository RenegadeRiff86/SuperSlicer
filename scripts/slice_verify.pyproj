<?xml version="1.0" encoding="utf-8"?>
<!--
  Python Tools for Visual Studio project for the slice-verification tooling.

  It exists so the verification workflow is visible in Solution Explorer and
  cannot be lost or forgotten. It is attached to the CMake-generated solution by
  include_external_msproject() in the top-level CMakeLists.txt, which is what
  makes it survive a cmake regeneration. Do not add it to the solution by hand.

  There is nothing to build; "building" a Python project is a no-op.
  See doc/slice-verification.md for what the script is for.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{6F3C1D9A-4B87-4E2A-9C5E-2B7A8D1F4E60}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>slice_verify.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <!-- Run from the repo root so the script's relative paths resolve. -->
    <WorkingDirectory>..</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>slice_verify</Name>
    <RootNamespace>slice_verify</RootNamespace>
    <!-- Default to listing the models; harmless and self-documenting on F5. -->
    <CommandLineArguments>models</CommandLineArguments>
    <IsWindowsApplication>False</IsWindowsApplication>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="slice_verify.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\doc\slice-verification.md" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" Condition="Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets')" />
</Project>
